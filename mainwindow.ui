       <!-- 5. 抓图与录像控制 -->
       <item>
        <widget class="QGroupBox" name="groupMedia">
         <property name="title">
          <string>抓图与录像控制</string>
         </property>
         <layout class="QGridLayout" name="gridLayout_media">
          <item row="0" column="0">
