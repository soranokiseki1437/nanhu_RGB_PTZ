          <mxGeometry x="1200" y="790" width="280" height="120" as="geometry" />
        </mxCell>

        <mxCell id="tTrack" value="ObjectTracker worker 线程（独立 QThread · QueuedConnection）❌ 未成功" style="rounded=0;dashed=1;dashPattern=6 4;fillColor=#fdf5f5;strokeColor=#cc0000;strokeWidth=2;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#b30000;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="70" y="980" width="680" height="470" as="geometry" />
        </mxCell>
        <mxCell id="fftutils" value="fftutils&#10;FFT / Hanning 窗 / 复数运算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e8;strokeColor=#cc0000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="1030" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ObjectTracker" value="ObjectTracker&#10;DSST：FHOG 特征 + 33 尺度相关滤波&#10;KF：位置 + 速度（kfX/kfY/kfVx/kfVy）&#10;PSR 置信度 / 遮挡重检测" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e8;strokeColor=#cc0000;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="1120" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="trackNote" value="processFrameSlot()&#10;跨线程排队调用（帧不丢）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;fontSize=10;fontColor=#666666;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="440" y="1030" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="TrackResult" value="TrackResult（跨线程结构体）&#10;bbox / confidence(PSR)&#10;kfX, kfY, kfVx, kfVy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e8;strokeColor=#cc0000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="440" y="1120" width="280" height="95" as="geometry" />
        </mxCell>
        <mxCell id="trackNote2" value="线程销毁顺序（不可变更）：&#10;disconnect → quit → wait → delete tracker → delete thread" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;fontSize=10;fontColor=#666666;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="440" y="1235" width="280" height="70" as="geometry" />
        </mxCell>

        <mxCell id="tLegend" value="图例" style="rounded=0;dashed=1;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;fontSize=14;fontStyle=1;fontColor=#333333;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1550" y="490" width="380" height="280" as="geometry" />
        </mxCell>
        <mxCell id="legendBody" value="&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.9;&quot;&gt;&lt;b style=&quot;color:#2f6fb5;&quot;&gt;━━&lt;/b&gt; 蓝色实线：视频 / 数据流&lt;br&gt;&lt;b style=&quot;color:#d79b00;&quot;&gt;━━&lt;/b&gt; 橙色实线：控制指令流&lt;br&gt;&lt;b style=&quot;color:#666666;&quot;&gt;━━&lt;/b&gt; 灰色实线：USB / 串口物理通道&lt;br&gt;&lt;b style=&quot;color:#cc0000;&quot;&gt;- -&lt;/b&gt; 红色虚线：跟踪闭环（❌ 未成功）&lt;br&gt;&lt;br&gt; 绿框：主线程模块　▣ 蓝框：采集/解码模块&lt;br&gt;▣ 橙框：控制/执行模块　 紫框：存储模块&lt;br&gt; &lt;b style=&quot;color:#cc0000;&quot;&gt;红框：未成功运行的模块&lt;/b&gt;&lt;br&gt;&lt;br&gt;虚线大框 = 线程边界（模块运行在哪条线程）&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1570" y="530" width="345" height="230" as="geometry" />
        </mxCell>

        <mxCell id="tFail" value="❌ 未成功环节（实测现象）" style="rounded=0;dashed=1;fillColor=#fdf5f5;strokeColor=#cc0000;strokeWidth=2;verticalAlign=top;align=left;fontSize=14;fontStyle=1;fontColor=#b30000;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1550" y="800" width="380" height="340" as="geometry" />
        </mxCell>
        <mxCell id="failBody" value="&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.8;&quot;&gt;① 框选目标后，&lt;b&gt;跟踪框向一个方向漂移&lt;/b&gt;&lt;br&gt;② 云台&lt;b&gt;跟着向同一方向不停旋转&lt;/b&gt;&lt;br&gt;③ 随后&lt;b&gt;软件崩溃&lt;/b&gt;&lt;br&gt;④ 云台保持原方向继续转（&lt;b&gt;故障保持&lt;/b&gt;，崩溃后未发停止指令）&lt;br&gt;⑤ 跟踪结果不可信，&lt;b&gt;DSST + KF 算法本身无法验证&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;已验证正常的部分：&lt;/b&gt;&lt;br&gt;· 相机 SDK 录像 / 抓图，文件可落到电脑&lt;br&gt;· 镜头变焦正常（经网络 → 接口板 → 机芯）&lt;br&gt;· 云台手动操作正常（Pelco-D 下发）&lt;br&gt;· 云台角度 / 位姿回传正常（定时查询）&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1570" y="840" width="345" height="290" as="geometry" />
        </mxCell>

        <mxCell id="tDebug" value="跟踪闭环失败的可能环节（待排查）" style="rounded=0;dashed=1;fillColor=#fafafa;strokeColor=#999999;verticalAlign=top;align=left;fontSize=14;fontStyle=1;fontColor=#333333;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1170" y="980" width="340" height="470" as="geometry" />
        </mxCell>
        <mxCell id="debugBody" value="&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.8;&quot;&gt;&lt;b&gt;1. 跟踪框单向漂移&lt;/b&gt;&lt;br&gt;DSST 响应图峰值定位异常 / 尺度估计发散 → bbox 持续偏向一侧 → KF 速度项持续同号&lt;br&gt;&lt;br&gt;&lt;b&gt;2. 云台单向不停转&lt;/b&gt;&lt;br&gt;PID 误差长期同号 → 积分项累积到上限（I_max=15）→ 限幅后仍为同向最大速度&lt;br&gt;&lt;br&gt;&lt;b&gt;3. 软件崩溃&lt;/b&gt;&lt;br&gt;worker 线程生命周期 / 跨线程信号在跟踪中重建 target 时的竞争&lt;br&gt;&lt;br&gt;&lt;b&gt;4. 云台故障保持&lt;/b&gt;&lt;br&gt;崩溃路径未走 stopTracking()，未下发 Pelco-D 停止帧（速度 0）&lt;br&gt;&lt;br&gt;&lt;b&gt;建议验证顺序：&lt;/b&gt;&lt;br&gt;① 关闭云台输出，只看跟踪框是否漂移&lt;br&gt;② 关跟踪，用固定误差测云台是否收敛&lt;br&gt;③ 崩溃点抓日志 / dump&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1190" y="1020" width="305" height="420" as="geometry" />
        </mxCell>

        <mxCell id="E1" value="JP1 · 36P 排线（视频 ↓ / 控制 ↑）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;startArrow=classic;startFill=1;endArrow=classic;endFill=1;strokeWidth=3;strokeColor=#2f6fb5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="hwCore" target="hwBoard">
