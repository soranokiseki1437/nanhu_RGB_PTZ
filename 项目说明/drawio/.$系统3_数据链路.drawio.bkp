  <diagram id="sys3-dataflow" name="系统3_数据链路">
    <mxGraphModel dx="2000" dy="1610" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1610" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="系统三：RGB_PTZ_Integrated · 数据链路图（软件模块 / 线程 / 信号）" style="text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1">
