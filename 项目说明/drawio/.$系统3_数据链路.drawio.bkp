        <mxCell id="hwCore" value="相机机芯 UV-ZNH2130DHA-P&#10;CMOS 传感器 + 镜头（变焦/聚焦/光圈）&#10;内部完成：H.264 编码 + 网络服务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="125" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="hwBoard" value="接口板（转换板）&#10;JP1：36P 机芯接口&#10;P1：RJ45 网络接口&#10;DC12V 转供机芯" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="470" y="125" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="hwNote" value="本项目包含两条独立链路，数据在软件层汇聚于主线程：&#10;① 视频链路：机芯 → 接口板 → 电脑（以太网）&#10;② 云台链路：云台 → USB 转 RS485 → 电脑（串口）&#10;镜头控制与抓图 / 录像指令也走 ① 的视频链路。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;fontSize=10;fontColor=#666666;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="740" y="125" width="450" height="110" as="geometry" />
        </mxCell>
        <mxCell id="hw485" value="USB 转 RS485 转换器&#10;USB 虚拟 COM 口  RS485 A/B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1230" y="125" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="hwPTZ" value="云台 YZ-BY025W&#10;Pelco-D 协议解析&#10;水平/俯仰电机 + 增量式编码器" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
