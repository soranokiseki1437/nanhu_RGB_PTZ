        <mxCell id="E5" value="录像帧队列" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;startArrow=none;endArrow=classic;endFill=1;strokeWidth=3;strokeColor=#2f6fb5;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="MainWindow" target="RecordThread">
          <mxGeometry relative="1" as="geometry">
