        <mxCell id="tMain" value="主线程（Qt UI 线程）" style="rounded=0;dashed=1;dashPattern=6 4;fillColor=#f8fbf5;strokeColor=#82b366;strokeWidth=2;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#5a8a45;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
