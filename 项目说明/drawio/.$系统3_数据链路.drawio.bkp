        <mxCell id="E6" value="写入 MP4 / MOV" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;startArrow=none;endArrow=classic;endFill=1;strokeWidth=3;strokeColor=#9673a6;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="RecordThread" target="outMedia">
