        </mxCell>

        <mxCell id="gHW" value="① 外部设备与接口（物理层）" style="rounded=0;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;align=center;fontSize=15;fontStyle=1;fontColor=#3d6b9e;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1920" height="190" as="geometry" />
