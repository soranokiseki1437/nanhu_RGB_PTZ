        <mxCell id="gPTZ" value="云台 YZ-BY025W（双轴 · 闭环 · 增量式编码器）" style="rounded=0;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;align=center;fontSize=14;fontStyle=1;fontColor=#3d6b9e;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="340" height="300" as="geometry" />
        </mxCell>
        <mxCell id="ptzBody" value="云台本体&#10;水平 0°~360° 连续旋转 / 俯仰 -90°~40°&#10;Pelco-D 协议 @ 9600 bps · 定位精度 ±0.1°&#10;负载 12~22 Kg · 防护等级 IP66" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="500" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="ptzLower" value="下部出线（唯一使用的云台线缆）&#10;DC24V 输入 + GND（系统供电）&#10;RS485：云台通讯（A / B 两线）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4fd;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="630" width="280" height="110" as="geometry" />
        </mxCell>

        <mxCell id="conv485" value="USB 转 RS485 转换器" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="660" width="330" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="RS485&#10;控制 ↓ / 回传 ↑" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;startArrow=classic;startFill=1;endArrow=classic;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=3;strokeColor=#6c8ebf;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ptzLower" target="conv485">
