        <mxCell id="dc24" value="DC24V 电源&#10;（系统供电，≤90 W）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="110" y="800" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="DC24V + GND" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;endArrow=classic;endFill=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;strokeWidth=2;strokeColor=#d6b656;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="dc24" target="ptzLower">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="ptzNote" value="相机机芯与云台为分体安装（非顶载），两者之间无物理连线。&#10;角度回传为「查询回传」：上位机定时发查询指令，云台经 RS485 回传当前水平 / 俯仰角度。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;fontSize=10;fontColor=#666666;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="620" height="60" as="geometry" />
        </mxCell>

        <mxCell id="cableTitle" value="线缆明细" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1060" y="740" width="460" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cableTable" value="&lt;table border=&quot;1&quot; cellpadding=&quot;6&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse;width:100%;font-size:10px;&quot;&gt;&lt;tr style=&quot;background:#f0f0f0;font-weight:bold;&quot;&gt;&lt;td width=&quot;40%&quot;&gt;连接（线缆）&lt;/td&gt;&lt;td&gt;关键信号&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;机芯 JP1 ↔ 接口板 JP1&lt;br&gt;&lt;b&gt;36P 排线&lt;/b&gt;&lt;/td&gt;&lt;td&gt;网络差分对 TPTX±/TPRX±、机芯 DC12V 供电、串口 232_TX/RX、报警 I/O、SD 卡信号&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;接口板 P1 ↔ 电脑网口&lt;br&gt;&lt;b&gt;以太网网线（独立布线）&lt;/b&gt;&lt;/td&gt;&lt;td&gt;视频流 ↑、SDK 指令 ↓（登录、抓图、录像、镜头变焦/聚焦/光圈）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;DC12V 适配器 → 接口板 PWR1&lt;br&gt;&lt;b&gt;DC 电源线&lt;/b&gt;&lt;/td&gt;&lt;td&gt;DC12V（接口板与机芯供电）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;云台下部 ↔ USB 转 RS485&lt;br&gt;&lt;b&gt;RS485 双绞线（A/B）&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Pelco-D 控制指令 ↓、角度回传 ↑（9600 bps）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;USB 转 RS485 ↔ 电脑 USB&lt;br&gt;&lt;b&gt;USB 2.0 线&lt;/b&gt;&lt;/td&gt;&lt;td&gt;串口数据双向（虚拟 COM 口）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;DC24V 电源 → 云台下部&lt;br&gt;&lt;b&gt;DC 电源线&lt;/b&gt;&lt;/td&gt;&lt;td&gt;DC24V + GND（云台供电，整机功耗 ≤90 W）&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1">
