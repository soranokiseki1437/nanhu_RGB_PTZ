          <mxGeometry x="610" y="440" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="DC12V" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;endArrow=classic;endFill=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;strokeWidth=2;strokeColor=#d6b656;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="dc12" target="boardPWR1">
